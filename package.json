{
  "name": "dsh-follow-up-prompts",
  "version": "1.1.6",
  "type": "module",
  "description": "Suggests follow-up instructions above the composer after each turn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susirsusir/dsh-follow-up-prompts.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "README.zh-CN.md",
    "README.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "selftest": "node scripts/selftest.mjs",
    "canary": "node scripts/canary.mjs"
  }
}
